{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the app windows",
  "windows": [
    "main",
    "settings",
    "compose-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "dialog:allow-ask",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
