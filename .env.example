# Local build settings, loaded by scripts/tauri.sh on every `npm run tauri …`.
# Copy to .env (gitignored) and edit. Values with spaces need quotes; what is
# set here wins over what the surrounding shell exported.

# macOS code signing identity for dev binaries and release bundles.
# Defaults to "flit-dev" when unset; set it here to use another one.
# List what the keychain holds with: security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY=flit-dev

# cmake binary for the llama.cpp build (on-device summaries). Only needed when
# cmake is not on PATH — e.g. installed with `python3 -m pip install --user cmake`.
# CMAKE=/Users/you/Library/Python/3.9/bin/cmake
